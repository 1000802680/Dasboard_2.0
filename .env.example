# Copia este archivo a .dev.vars para desarrollo local y llena los valores.
# NO subas .dev.vars ni pegues estos secretos en GitHub.
SEATABLE_SERVER_URL=https://cloud.seatable.io
SEATABLE_API_TOKEN=
SEATABLE_BASE_UUID=
# UUID de una base separada para usuarios/auditoría (recomendado); vacío usa la base principal.
SEATABLE_AUTH_BASE_UUID=
# Token adicional con permiso de escritura para la base de acceso/auditoría.
SEATABLE_AUTH_API_TOKEN=
AUTH_SESSION_SECRET=
AUTH_BOOTSTRAP_KEY=
# Deja vacío para descubrir y leer automáticamente todas las tablas del base.
# Para limitar la lectura, agrega los nombres separados por coma.
SEATABLE_VIEW_NAME=

# JSON opcional que relaciona las claves internas del dashboard con los
# encabezados exactos de columnas de SeaTable. Ejemplo:
# SEATABLE_COLUMN_MAP={"P":"PROYECTO","O":"NUMERO DE OPA","E":"ESTADO PLATAFORMA"}
SEATABLE_COLUMN_MAP=

